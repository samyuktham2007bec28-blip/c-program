#include <stdbool.h>
void setZeroes(int** matrix, int matrixSize, int* matrixColSize) {
    int m = matrixSize;
    int n = matrixColSize[0];
    bool firstColZero = false;
    for (int r = 0; r < m; r++) {
        if (matrix[r][0] == 0) {
            firstColZero = true;
        }
        for (int c = 1; c < n; c++) {
            if (matrix[r][c] == 0) {
                matrix[r][0] = 0; 
                matrix[0][c] = 0; 
            }
        }
    }
    for (int r = m - 1; r >= 0; r--) {
        for (int c = n - 1; c >= 1; c--) {
            if (matrix[r][0] == 0 || matrix[0][c] == 0) {
                matrix[r][c] = 0;
            }
        }
        if (firstColZero) {
            matrix[r][0] = 0;
        }
    }
}

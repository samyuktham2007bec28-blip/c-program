#include <stdio.h>
int mySqrt(int x) {
    if (x == 0 || x == 1) {
        return x;
    }
    int left = 1;
    int right = x;
    int ans = 0;
    while (left <= right) {
        int mid = left + (right - left) / 2;
        if (mid <= x / mid) {
            ans = mid;     
            left = mid + 1; 
        } else {
            right = mid - 1;
        }
    }
    return ans;
}
int Main() {
    int test1 = 4;
    int test2 = 8;
    int test3 = 2147483647; 
    printf("Input: %d -> Output: %d\n", test1, mySqrt(test1));
    printf("Input: %d -> Output: %d\n", test2, mySqrt(test2));
    printf("Input: %d -> Output: %d\n", test3, mySqrt(test3));
    return 0;
}

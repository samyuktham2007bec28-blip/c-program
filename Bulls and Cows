#include <stdio.h>
#include <stdlib.h>
#include <string.h>
char* getHint(char* secret, char* guess) {
    int len = strlen(secret);
    int bulls = 0;
    int cows = 0;
    int digitCounts[10] = {0};
    for (int i = 0; i < len; i++) {
        int sDigit = secret[i] - '0';
        int gDigit = guess[i] - '0';
        if (sDigit == gDigit) {
            bulls++;
        } else {
            if (digitCounts[sDigit] < 0) {
                cows++;
            }
            if (digitCounts[gDigit] > 0) {
                cows++;
            }
            digitCounts[sDigit]++; 
            digitCounts[gDigit]--; 
        }
    }
    char* hint = (char*)malloc(20 * sizeof(char));
    sprintf(hint, "%dA%dB", bulls, cows);
    
    return hint;
}

#include <stdio.h>
#include <string.h>
#include <math.h>
#include <stdlib.h>
int main() {
    char s[1000];
    int frequency[10] = {0}; 
    scanf("%s", s);
    int length = strlen(s);
    for (int i = 0; i < length; i++) {
        if (isdigit(s[i])) {
            frequency[s[i] - '0']++;
        }}
    for (int i = 0; i < 10; i++) {
        printf("%d ", frequency[i]);}
    printf("\n");
    return 0;
}

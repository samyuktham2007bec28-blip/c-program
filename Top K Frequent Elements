#include <stdio.h>
#include <stdlib.h>
int* topKFrequent(int* nums, int numsSize, int k, int* returnSize) {
    int offset = 10000;
    int freqSize = 20001;
    int* freq = (int*)calloc(freqSize, sizeof(int));
    for (int i = 0; i < numsSize; i++) {
        freq[nums[i] + offset]++;
    }
    int* bucket_sizes = (int*)calloc(numsSize + 1, sizeof(int));
    for (int i = 0; i < freqSize; i++) {
        if (freq[i] > 0) {
            bucket_sizes[freq[i]]++;
        }
    }
    int** buckets = (int**)malloc((numsSize + 1) * sizeof(int*));
    for (int i = 0; i <= numsSize; i++) {
        if (bucket_sizes[i] > 0) {
            buckets[i] = (int*)malloc(bucket_sizes[i] * sizeof(int));
        } else {
            buckets[i] = NULL;
        }
    }
    int* bucket_counters = (int*)calloc(numsSize + 1, sizeof(int));
    for (int i = 0; i < freqSize; i++) {
        if (freq[i] > 0) {
            int f = freq[i];
            int original_val = i - offset;
            buckets[f][bucket_counters[f]++] = original_val;
        }
    }
    int* result = (int*)malloc(k * sizeof(int));
    int res_idx = 0;
    for (int i = numsSize; i > 0; i--) {
        if (bucket_sizes[i] > 0) {
            for (int j = 0; j < bucket_sizes[i]; j++) {
                result[res_idx++] = buckets[i][j];
                if (res_idx == k) {
                    break;
                }
            }
        }
        if (res_idx == k) {
            break;
        }
    }
    for (int i = 0; i <= numsSize; i++) {
        if (buckets[i] != NULL) {
            free(buckets[i]);
        }
    }
    free(buckets);
    free(bucket_sizes);
    free(bucket_counters);
    free(freq);
    *returnSize = k;
    return result;
}

struct TreeNode* createNode(int val) {
    struct TreeNode* node = (struct TreeNode*)malloc(sizeof(struct TreeNode));
    node->val = val;
    node->left = NULL;
    node->right = NULL;
    return node;
}
struct TreeNode* buildTreeHelper(int* preorder, int* pre_idx, int in_left, int in_right, int* inorder_map) {
    if (in_left > in_right) {
        return NULL;
    }
    int root_val = preorder[*pre_idx];
    struct TreeNode* root = createNode(root_val);
    (*pre_idx)++;
    int root_index = inorder_map[root_val + 3000];
    root->left = buildTreeHelper(preorder, pre_idx, in_left, root_index - 1, inorder_map);
    root->right = buildTreeHelper(preorder, pre_idx, root_index + 1, in_right, inorder_map);
    return root;
}
struct TreeNode* buildTree(int* preorder, int preorderSize, int* inorder, int inorderSize) {
    if (preorderSize == 0 || inorderSize == 0) return NULL;
    int inorder_map[6001];
    for (int i = 0; i < inorderSize; i++) {
        inorder_map[inorder[i] + 3000] = i;
    }
    int pre_idx = 0;
    return buildTreeHelper(preorder, &pre_idx, 0, inorderSize - 1, inorder_map);
}

